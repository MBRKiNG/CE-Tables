              <AssemblerScript>{ Game   : mgv.exe
  Version:
  Date   : 2026-07-30
  Author : steamuser
  Description :

  &lt;Optional info&gt;
}

[ENABLE]

aobscanmodule(coschange,mgv.exe,8B ?? ?? ?? ?? ?? ?? EB ?? 48 ?? ?? FF ?? ?? 8B ?? 83) // should be unique
alloc(newmem,$1000,coschange)

label(code)
label(return)
label(cosmetic)
registersymbol(cosmetic)
newmem:

code:
  mov [cosmetic],rax
  mov eax,[rax+rcx*4+000001F0]
  jmp return
cosmetic:
  db
coschange:
  jmp newmem
  nop 2
return:
registersymbol(coschange)

[DISABLE]
coschange:
  db 8B 84 88 F0 01 00 00
unregistersymbol(*)
dealloc(*)

