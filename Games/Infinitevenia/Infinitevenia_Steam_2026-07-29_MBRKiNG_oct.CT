if syntaxcheck then return end

[ENABLE]
openProcess('Infinitevania')
synchronize(LaunchMonoDataCollector)

function parseStringSegments(inputStr)
    local segments = {}
    for segment in inputStr:gmatch("[A-Za-z0-9_&lt;&gt;]+") do
        table.insert(segments, segment)
    end
    return segments
end

function DissectCode(address)
    if not address then
        address = inputQuery('Enter Address', 'Address:', '')
    end
    if not address or address == '' then
        return
    end
    local structureForm = createStructureForm(string.format('%X', getAddress(address)))
    structureForm.Definenewstructure1.doClick()
end

function FetchField(symbolStr)
    local segments = parseStringSegments(symbolStr)
    local fieldName = segments[#segments]
    local className = segments[#segments - 1]
    local namespace = (#segments &gt; 2) and segments[#segments - 2] or ''

    local classRef = mono_findClass(namespace, className)
    if not classRef then return nil end

    local staticFields = mono_class_enumFields(classRef, true)
    if staticFields then
        for _, field in pairs(staticFields) do
            if field.isStatic and (field.name == fieldName or field.name == '&lt;' .. fieldName .. '&gt;k__BackingField') then
                return mono_class_getStaticFieldAddress(namespace, classRef) + field.offset
            end
        end
    end

    local instanceFields = mono_class_enumFields(classRef, false)
    if instanceFields then
        local instances = mono_class_enumInstances(classRef)
        if instances and #instances &gt; 0 then
            for _, field in pairs(instanceFields) do
                if field.name == fieldName or field.name == '&lt;' .. fieldName .. '&gt;k__BackingField' then
                    return instances[1] + field.offset
                end
            end
        end
    end

    return nil
end


registerSymbol('PlayerInvulnerable', FetchField('DeveloperMenu.PlayerInvulnerable'))
-- registerSymbol('AnotherField', FetchField('ClassName.FieldName'))

[DISABLE]
if monopipe then
    monopipe.destroy()
    monopipe = nil
end
unregisterSymbol('PlayerInvulnerable')

